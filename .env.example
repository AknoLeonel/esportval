# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://esportval.vercel.app

# --- Observabilidade (todas opcionais: sem chave, o provedor fica desligado) --
# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Datadog RUM
NEXT_PUBLIC_DD_APPLICATION_ID=
NEXT_PUBLIC_DD_CLIENT_TOKEN=
NEXT_PUBLIC_DD_SITE=datadoghq.com
# New Relic Browser
NEXT_PUBLIC_NEWRELIC_ACCOUNT_ID=
NEXT_PUBLIC_NEWRELIC_TRUST_KEY=
NEXT_PUBLIC_NEWRELIC_AGENT_ID=
NEXT_PUBLIC_NEWRELIC_LICENSE_KEY=
NEXT_PUBLIC_NEWRELIC_APPLICATION_ID=
# OpenTelemetry (exporter OTLP opcional; na Vercel já funciona via @vercel/otel)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# --- Contato -----------------------------------------------------------------
# Webhook que recebe as inscrições (ex.: Zapier, Make, Slack). Opcional.
CONTACT_WEBHOOK_URL=
